publish/
artifacts/
BenchmarkDotNet.Artifacts/
# Cobertura de pruebas
coverage/
*.coverage
*.coveragexml
*.cobertura.xml
# Datos locales del flujo de trabajo con el agente (ledger, notas)
.superpowers/

# ===== ragCustomerBot: archivos que genera el bot al usarse =====
# Resultados del modo eval (las preguntas eval/questions.json SÍ se versionan)
**/eval/results/
**/eval/*.out.json
# Transcripciones de chat: pueden contener datos reales de clientes
chat-logs/
transcripts/
*.jsonl

