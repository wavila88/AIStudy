# Copia este archivo a .env y completa los valores
PINECONE_API_KEY=
# Ejemplos: libros (demo original, 384 dimensiones) o customer-service-kb (RAG de servicio al cliente, 1024)
PINECONE_INDEX_NAME=customer-service-kb
# Opcional: host del index (consola Pinecone > index > Host). Si se omite, se resuelve por nombre.
# OJO: si lo dejas puesto, manda sobre PINECONE_INDEX_NAME. Al cambiar de índice, cámbialo o bórralo.
PINECONE_HOST=
# Opcional: namespace a usar (vacío = namespace por defecto). customer-service-kb usa "kb".
PINECONE_NAMESPACE=kb
